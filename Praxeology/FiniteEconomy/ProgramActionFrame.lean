module

public import Praxeology.FiniteEconomy.Program

/-!
# ActionFrame adapter for recursive physical programs

This adapter uses the branching moments and histories already generated by a
finite physical program. Inventory transitions remain those of
`FinitePhysicalChoiceStage.advance`. Stable action schedules and behavioral
inputs are stated at this adapter boundary rather than added to the general
`ActionFrame` interface.
-/

@[expose] public section

namespace Praxeology

/-- Physical bundles, timed bundles, and quantity ends for a program-generated
moment type. -/
inductive FiniteProgramEnd (Moment Means : Type) where
  | bundle : (Means → ℕ) → FiniteProgramEnd Moment Means
  | timed : FiniteProgramEnd Moment Means → Moment → FiniteProgramEnd Moment Means
  | quantity : Means → ℕ → FiniteProgramEnd Moment Means

noncomputable instance finiteProgramEndDecidableEq {Moment Means : Type}
    [DecidableEq Moment] [DecidableEq Means] :
    DecidableEq (FiniteProgramEnd Moment Means) := Classical.decEq _

/-- Means required by a program end. -/
def finiteProgramEndRequirement {Moment Means : Type} [DecidableEq Means] :
    FiniteProgramEnd Moment Means → Means → ℕ
  | .bundle bundle, m => bundle m
  | .timed e _, m => finiteProgramEndRequirement e m
  | .quantity m' q, m => if m = m' then q else 0

namespace FinitePhysicalEconomyProgram

variable {Agent Means Operation Service : Type}
variable [Fintype Agent] [DecidableEq Agent]
  [Fintype Means] [DecidableEq Means] [DecidableEq Operation]

abbrev Moment {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state) :=
  FiniteEconomyProgram.ProgramMoment program.toFiniteEconomyProgram

abbrev End {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state) :=
  FiniteProgramEnd (program.Moment) Means

/-- Declared horizon used to evaluate an action in a recursive program. -/
inductive EvaluationHorizon where
  | immediateSuccessor
  | terminalSettlement
  deriving DecidableEq

/-- A program-scoped behavioral specification. Each reference history is
required to pass through its decision moment. The adapter treats that one
history as the agent's sole minimal-plausibility history, so it represents a
certainty case. Valuations and preferences are history-invariant at shared
moments, and asymmetric preferences remain explicit local laws. -/
structure ActionFrameBehavior
    {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state) where
  referenceHistory : Agent → program.Moment → program.History
  referenceHistory_mem : ∀ i t,
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t
      (referenceHistory i t)
  /-- Full branch supplied for evaluating a contemplated action. When the
  action changes, this branch provides the continuation after its resulting
  successor; it is not replaced by an implicit all-idle suffix. -/
  selectedHistory : Agent → program.Moment → EconomyAction Agent Means Operation →
    program.History → program.History
  selectedHistory_mem : ∀ i t action history,
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t history →
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t
      (selectedHistory i t action history)
  /-- An alternative branch keeps the supplied history's actions at every
  earlier moment on the common prefix. -/
  selectedHistory_past : ∀ i t action history,
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t history →
    action ∈ t.currentStage.menu i →
    ∀ past,
      FiniteEconomyProgram.ProgramMoment.Precedence program.toFiniteEconomyProgram past t →
      ∀ j, FiniteEconomyProgram.ProgramHistory.enactedAt
          (selectedHistory i t action history) past j =
        FiniteEconomyProgram.ProgramHistory.enactedAt history past j
  selectedHistory_action : ∀ i t action history,
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t history →
    action ∈ t.currentStage.menu i →
    FiniteEconomyProgram.ProgramHistory.enactedAt
      (selectedHistory i t action history) t i = action
  selectedHistory_other : ∀ i j t action history,
    i ≠ j →
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t history →
    action ∈ t.currentStage.menu i →
    FiniteEconomyProgram.ProgramHistory.enactedAt
      (selectedHistory i t action history) t j =
      FiniteEconomyProgram.ProgramHistory.enactedAt history t j
  /-- Selecting an action already enacted on the input branch preserves the
  entire branch, including its continuation. -/
  selectedHistory_centered : ∀ i t action history,
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t history →
    action ∈ t.currentStage.menu i →
    FiniteEconomyProgram.ProgramHistory.enactedAt history t i = action →
    selectedHistory i t action history = history
  evaluationHorizon : Agent → program.Moment →
    EconomyAction Agent Means Operation → EvaluationHorizon
  valuedEnd : Agent → program.Moment → program.History → program.End → Prop
  valuedEnd_invariant : ∀ i t {h₁ h₂ : program.History} e,
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t h₁ →
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t h₂ →
    (valuedEnd i t h₁ e ↔ valuedEnd i t h₂ e)
  preference : Agent → program.Moment → program.History → program.End → program.End → Prop
  preference_invariant : ∀ i t {h₁ h₂ : program.History},
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t h₁ →
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t h₂ →
    preference i t h₁ = preference i t h₂
  preference_asymmetric : ∀ i t h {e₁ e₂ : program.End},
    preference i t h e₁ e₂ → ¬ preference i t h e₂ e₁
  teleological_dominance_prefers : ∀ i t h b₁ b₂,
    SubjectiveTeleologicalDominates finiteProgramEndRequirement
      (valuedEnd i t h) b₁ b₂ →
    preference i t h (.bundle b₁) (.bundle b₂)

/-- Replace only the declared evaluation horizon, preserving supplied
histories, valuations, and preference laws. -/
def ActionFrameBehavior.withEvaluationHorizon
    {fuel : ℕ} {state : PhysicalState Agent Means Service}
    {program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state}
    (behavior : program.ActionFrameBehavior)
    (horizon : Agent → program.Moment → EconomyAction Agent Means Operation →
      EvaluationHorizon) :
    program.ActionFrameBehavior :=
  { behavior with evaluationHorizon := horizon }

/-- Replace only root counterfactual continuations with a behavior-supplied
state-dependent policy. The unchanged root action keeps the complete input
history. At other moments, the original behavior selector remains in force. -/
noncomputable def ActionFrameBehavior.withRootContinuation
    {fuel : ℕ} {Agent Means Operation Service : Type}
    [Fintype Agent] [DecidableEq Agent] [Fintype Means]
    [DecidableEq Means] [DecidableEq Operation]
    {stage : FinitePhysicalChoiceStage Agent Means Operation Service}
    {continuation : ∀ profile,
      FinitePhysicalEconomyProgram Agent Means Operation Service fuel
        (stage.advance profile)}
    (behavior : (FinitePhysicalEconomyProgram.decision (state := stage.before)
      stage continuation).ActionFrameBehavior)
    (continueWith : ∀ profile,
      FinitePhysicalEconomyProgram.History (continuation profile)) :
    (FinitePhysicalEconomyProgram.decision (state := stage.before)
      stage continuation).ActionFrameBehavior := by
  classical
  let physicalProgram : FinitePhysicalEconomyProgram Agent Means Operation Service
      (fuel + 1) stage.before := .decision (state := stage.before) stage continuation
  let program := physicalProgram.toFiniteEconomyProgram
  let selectHistory : Agent → FiniteEconomyProgram.ProgramMoment program →
      EconomyAction Agent Means Operation → FiniteEconomyProgram.ProgramHistory program →
        FiniteEconomyProgram.ProgramHistory program := fun actor moment action history =>
    if hroot : moment = FiniteEconomyProgram.ProgramMoment.root then
      if haction : action ∈ stage.choices.menu actor then
        history.selectActorAtRootWithContinuation actor action
          haction continueWith
      else history
    else behavior.selectedHistory actor moment action history
  refine { behavior with
    selectedHistory := selectHistory
    selectedHistory_mem := ?_
    selectedHistory_past := ?_
    selectedHistory_action := ?_
    selectedHistory_other := ?_
    selectedHistory_centered := ?_ }
  · intro actor moment action history hmem
    by_cases hroot : moment = FiniteEconomyProgram.ProgramMoment.root
    · subst moment
      exact FiniteEconomyProgram.ProgramMoment.root_memHist
        (selectHistory actor FiniteEconomyProgram.ProgramMoment.root action history)
    · simpa [selectHistory, hroot] using
        behavior.selectedHistory_mem actor moment action history hmem
  · intro actor moment action history hmem haction past hbefore other
    by_cases hroot : moment = FiniteEconomyProgram.ProgramMoment.root
    · subst moment
      have hfalse : False := by
        cases past <;> simp [FiniteEconomyProgram.ProgramMoment.Precedence] at hbefore
      exact False.elim hfalse
    · simpa [selectHistory, hroot] using
        behavior.selectedHistory_past actor moment action history hmem haction
          past hbefore other
  · intro actor moment action history hmem haction
    by_cases hroot : moment = FiniteEconomyProgram.ProgramMoment.root
    · subst moment
      have hmenu : action ∈ stage.choices.menu actor := by
        simpa [program, FiniteEconomyProgram.ProgramMoment.currentStage,
          FinitePhysicalEconomyProgram.toFiniteEconomyProgram,
          FiniteEconomyProgram.physicalDecision] using haction
      have hselectedHistory : selectHistory actor
          FiniteEconomyProgram.ProgramMoment.root action history =
            history.selectActorAtRootWithContinuation actor action hmenu continueWith := by
        simp only [selectHistory, dite_eq_left rfl]
        dsimp [program, physicalProgram, FinitePhysicalEconomyProgram.toFiniteEconomyProgram,
          FiniteEconomyProgram.physicalDecision]
        by_cases hactual : action ∈ stage.choices.menu actor
        · calc
            (if h : action ∈ stage.choices.menu actor then
              history.selectActorAtRootWithContinuation actor action h continueWith
             else history) =
                history.selectActorAtRootWithContinuation actor action hactual continueWith := by
                  simp [hactual]
            _ = history.selectActorAtRootWithContinuation actor action hmenu continueWith := by
                rw [Subsingleton.elim hactual hmenu]
        · exact False.elim (hactual hmenu)
      rw [hselectedHistory]
      exact FiniteEconomyProgram.ProgramHistory.selectActorAtRootWithContinuation_enacted
        history actor action hmenu continueWith
    · simpa [selectHistory, hroot] using
        behavior.selectedHistory_action actor moment action history hmem haction
  · intro actor other moment action history hne hmem haction
    by_cases hroot : moment = FiniteEconomyProgram.ProgramMoment.root
    · subst moment
      have hmenu : action ∈ stage.choices.menu actor := by
        simpa [program, FiniteEconomyProgram.ProgramMoment.currentStage,
          FinitePhysicalEconomyProgram.toFiniteEconomyProgram,
          FiniteEconomyProgram.physicalDecision] using haction
      have hselectedHistory : selectHistory actor
          FiniteEconomyProgram.ProgramMoment.root action history =
            history.selectActorAtRootWithContinuation actor action hmenu continueWith := by
        simp only [selectHistory, dite_eq_left rfl]
        dsimp [program, physicalProgram, FinitePhysicalEconomyProgram.toFiniteEconomyProgram,
          FiniteEconomyProgram.physicalDecision]
        by_cases hactual : action ∈ stage.choices.menu actor
        · calc
            (if h : action ∈ stage.choices.menu actor then
              history.selectActorAtRootWithContinuation actor action h continueWith
             else history) =
                history.selectActorAtRootWithContinuation actor action hactual continueWith := by
                  simp [hactual]
            _ = history.selectActorAtRootWithContinuation actor action hmenu continueWith := by
                rw [Subsingleton.elim hactual hmenu]
        · exact False.elim (hactual hmenu)
      rw [hselectedHistory]
      exact FiniteEconomyProgram.ProgramHistory.selectActorAtRootWithContinuation_other
        history actor other action hmenu hne.symm continueWith
    · simpa [selectHistory, hroot] using
        behavior.selectedHistory_other actor other moment action history hne hmem haction
  · intro actor moment action history hmem haction henacted
    by_cases hroot : moment = FiniteEconomyProgram.ProgramMoment.root
    · subst moment
      have hmenu : action ∈ stage.choices.menu actor := by
        simpa [program, FiniteEconomyProgram.ProgramMoment.currentStage,
          FinitePhysicalEconomyProgram.toFiniteEconomyProgram,
          FiniteEconomyProgram.physicalDecision] using haction
      have hselectedHistory : selectHistory actor
          FiniteEconomyProgram.ProgramMoment.root action history =
            history.selectActorAtRootWithContinuation actor action hmenu continueWith := by
        simp only [selectHistory, dite_eq_left rfl]
        dsimp [program, physicalProgram, FinitePhysicalEconomyProgram.toFiniteEconomyProgram,
          FiniteEconomyProgram.physicalDecision]
        by_cases hactual : action ∈ stage.choices.menu actor
        · calc
            (if h : action ∈ stage.choices.menu actor then
              history.selectActorAtRootWithContinuation actor action h continueWith
             else history) =
                history.selectActorAtRootWithContinuation actor action hactual continueWith := by
                  simp [hactual]
            _ = history.selectActorAtRootWithContinuation actor action hmenu continueWith := by
                rw [Subsingleton.elim hactual hmenu]
        · exact False.elim (hactual hmenu)
      rw [hselectedHistory]
      exact FiniteEconomyProgram.ProgramHistory.selectActorAtRootWithContinuation_centered
        history actor action hmenu henacted continueWith
    · simpa [selectHistory, hroot] using
        behavior.selectedHistory_centered actor moment action history hmem haction henacted

/-- At the root, a valid requested action is realized by replacing that
actor's action in the supplied profile and continuing with `continueWith`.
This exposes the branch selected by `withRootContinuation` for downstream
physical-run correspondence proofs. -/
theorem ActionFrameBehavior.withRootContinuation_selectedHistory_root
    {fuel : ℕ} {Agent Means Operation Service : Type}
    [Fintype Agent] [DecidableEq Agent] [Fintype Means]
    [DecidableEq Means] [DecidableEq Operation]
    {stage : FinitePhysicalChoiceStage Agent Means Operation Service}
    {continuation : ∀ profile,
      FinitePhysicalEconomyProgram Agent Means Operation Service fuel
        (stage.advance profile)}
    (behavior : (FinitePhysicalEconomyProgram.decision (state := stage.before)
      stage continuation).ActionFrameBehavior)
    (continueWith : ∀ profile,
      FinitePhysicalEconomyProgram.History (continuation profile))
    (actor : Agent) (action : EconomyAction Agent Means Operation)
    (history : (FinitePhysicalEconomyProgram.decision (state := stage.before)
      stage continuation).History)
    (hmenu : action ∈ stage.choices.menu actor) :
    (behavior.withRootContinuation continueWith).selectedHistory actor
      FiniteEconomyProgram.ProgramMoment.root action history =
      history.selectActorAtRootWithContinuation actor action hmenu continueWith := by
  classical
  let physicalProgram := FinitePhysicalEconomyProgram.decision
    (state := stage.before) stage continuation
  let program := physicalProgram.toFiniteEconomyProgram
  let selectHistory : Agent → FiniteEconomyProgram.ProgramMoment program →
      EconomyAction Agent Means Operation → FiniteEconomyProgram.ProgramHistory program →
        FiniteEconomyProgram.ProgramHistory program := fun actor moment action history =>
    if hroot : moment = FiniteEconomyProgram.ProgramMoment.root then
      if haction : action ∈ stage.choices.menu actor then
        history.selectActorAtRootWithContinuation actor action haction continueWith
      else history
    else behavior.selectedHistory actor moment action history
  change selectHistory actor FiniteEconomyProgram.ProgramMoment.root action history = _
  simp only [selectHistory, dite_eq_left rfl]
  dsimp [program, physicalProgram,
    FinitePhysicalEconomyProgram.toFiniteEconomyProgram,
    FiniteEconomyProgram.physicalDecision]
  by_cases hactual : action ∈ stage.choices.menu actor
  · calc
      (if h : action ∈ stage.choices.menu actor then
        history.selectActorAtRootWithContinuation actor action h continueWith
       else history) =
          history.selectActorAtRootWithContinuation actor action hactual continueWith := by
            simp [hactual]
      _ = history.selectActorAtRootWithContinuation actor action hmenu continueWith := by
          rw [Subsingleton.elim hactual hmenu]
  · exact False.elim (hactual hmenu)

/-- Inventory at a program-generated moment. -/
def stateAt {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (moment : program.Moment) : PhysicalState Agent Means Service :=
  moment.currentState

/-- Reading inventory at a history's terminal moment gives the terminal
state reached by the recursive program interpreter. -/
theorem stateAt_terminalMoment {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (history : program.History) :
    program.stateAt history.terminalMoment = history.terminalState := by
  induction program with
  | halt => cases history; rfl
  | decision stage continuation ih =>
      cases history with
      | decision profile tail => exact ih profile tail

/-- Convenience selector for one actor's action at a program moment. If the
root profile changes, this particular selector uses the program's all-idle
history for the new continuation. The ActionFrame adapter instead delegates
changed-action continuations to `ActionFrameBehavior.selectedHistory`. Invalid
requests retain the supplied history so this remains a total selector. -/
noncomputable def selectAt {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (actor : Agent) (moment : program.Moment) (action : EconomyAction Agent Means Operation)
    (history : program.History) : program.History := by
  classical
  exact if hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history then
    if haction : action ∈ moment.currentStage.menu actor then
      FiniteEconomyProgram.ProgramHistory.selectActorAtMoment moment history hmem
        actor action haction
    else history
  else history

/-- The selected history preserves incidence of the decision moment. -/
theorem selectAt_memHist {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (actor : Agent) (moment : program.Moment) (action : EconomyAction Agent Means Operation)
    (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history) :
    FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment
      (program.selectAt actor moment action history) := by
  classical
  by_cases haction : action ∈ moment.currentStage.menu actor
  · simpa [selectAt, hmem, haction] using
      FiniteEconomyProgram.ProgramHistory.selectActorAtMoment_memHist
        moment history hmem actor action haction
  · simp [selectAt, hmem, haction]

/-- At a history-incidental moment, selecting an action from its current menu
enacts that action on the selected history. -/
theorem selectAt_enacted {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (actor : Agent) (moment : program.Moment) (action : EconomyAction Agent Means Operation)
    (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history)
    (haction : action ∈ moment.currentStage.menu actor) :
    FiniteEconomyProgram.ProgramHistory.enactedAt
      (program.selectAt actor moment action history) moment actor =
      action := by
  classical
  unfold selectAt
  simp only [dite_eq_left hmem, dite_eq_left haction]
  exact FiniteEconomyProgram.ProgramHistory.selectActorAtMoment_enacted
    moment history hmem actor action haction

/-- A unilateral program selection preserves the other agents' actions at
the same moment. -/
theorem selectAt_other {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (actor other : Agent) (moment : program.Moment)
    (action : EconomyAction Agent Means Operation) (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history)
    (haction : action ∈ moment.currentStage.menu actor) (hne : other ≠ actor) :
    FiniteEconomyProgram.ProgramHistory.enactedAt
      (program.selectAt actor moment action history) moment other =
      FiniteEconomyProgram.ProgramHistory.enactedAt history moment other := by
  classical
  unfold selectAt
  simp only [dite_eq_left hmem, dite_eq_left haction]
  exact FiniteEconomyProgram.ProgramHistory.selectActorAtMoment_other
    moment history hmem actor other action haction hne

/-- If the history already records the selected action, selection leaves it
unchanged. -/
theorem selectAt_centered {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (actor : Agent) (moment : program.Moment) (action : EconomyAction Agent Means Operation)
    (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history)
    (haction : action ∈ moment.currentStage.menu actor)
    (henacted : FiniteEconomyProgram.ProgramHistory.enactedAt
      history moment actor = action) :
    program.selectAt actor moment action history = history := by
  classical
  unfold selectAt
  simp only [dite_eq_left hmem, dite_eq_left haction]
  exact FiniteEconomyProgram.ProgramHistory.selectActorAtMoment_centered
    moment history hmem actor action haction henacted

/-- Build the history-selection part of a physical-program behavior from an
explicit reference history. Valuations and preferences remain explicit
behavioral inputs; callers must supply their invariance, asymmetry, and
teleological-bridge evidence. -/
noncomputable def ActionFrameBehavior.fromReferenceHistory
    {fuel : ℕ} {state : PhysicalState Agent Means Service}
    {program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state}
    (referenceHistory : Agent → program.Moment → program.History)
    (referenceHistory_mem : ∀ i t,
      FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t
        (referenceHistory i t))
    (valuedEnd : Agent → program.Moment → program.History → program.End → Prop)
    (valuedEnd_invariant : ∀ i t {h₁ h₂ : program.History} e,
      FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t h₁ →
      FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t h₂ →
      (valuedEnd i t h₁ e ↔ valuedEnd i t h₂ e))
    (preference : Agent → program.Moment → program.History → program.End → program.End → Prop)
    (preference_invariant : ∀ i t {h₁ h₂ : program.History},
      FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t h₁ →
      FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram t h₂ →
      preference i t h₁ = preference i t h₂)
    (preference_asymmetric : ∀ i t h {e₁ e₂ : program.End},
      preference i t h e₁ e₂ → ¬ preference i t h e₂ e₁)
    (teleological_dominance_prefers : ∀ i t h b₁ b₂,
      SubjectiveTeleologicalDominates finiteProgramEndRequirement
        (valuedEnd i t h) b₁ b₂ →
      preference i t h (.bundle b₁) (.bundle b₂)) :
    program.ActionFrameBehavior := by
  classical
  refine {
    referenceHistory := referenceHistory
    referenceHistory_mem := referenceHistory_mem
    selectedHistory := fun actor moment action history =>
      program.selectAt actor moment action history
    selectedHistory_mem := ?_
    selectedHistory_past := ?_
    selectedHistory_action := ?_
    selectedHistory_other := ?_
    selectedHistory_centered := ?_
    evaluationHorizon := fun _ _ _ => .terminalSettlement
    valuedEnd := valuedEnd
    valuedEnd_invariant := valuedEnd_invariant
    preference := preference
    preference_invariant := preference_invariant
    preference_asymmetric := preference_asymmetric
    teleological_dominance_prefers := teleological_dominance_prefers }
  · intro actor moment action history hmem
    exact program.selectAt_memHist actor moment action history hmem
  · intro actor moment action history hmem haction past hbefore other
    have hselectedMem := program.selectAt_memHist actor moment action history hmem
    exact FiniteEconomyProgram.ProgramHistory.enactedAt_eq_of_shared_future
      (program.selectAt actor moment action history) history past moment hbefore
      hselectedMem hmem other
  · intro actor moment action history hmem haction
    exact program.selectAt_enacted actor moment action history hmem haction
  · intro actor other moment action history hne hmem haction
    exact program.selectAt_other actor other moment action history hmem haction hne.symm
  · intro actor moment action history hmem haction henacted
    exact program.selectAt_centered actor moment action history hmem haction henacted

/-- Select the behavior-supplied branch for a feasible action. Invalid actions
and histories outside the decision node retain the input history. -/
noncomputable def selectByBehavior {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor : Agent) (moment : program.Moment)
    (action : EconomyAction Agent Means Operation) (history : program.History) :
    program.History := by
  classical
  exact if hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history then
    if haction : action ∈ moment.currentStage.menu actor then
      behavior.selectedHistory actor moment action history
    else history
  else history

/-- At a feasible decision on an incident history, the adapter uses exactly
the complete branch supplied by the behavioral specification. -/
theorem selectByBehavior_eq_selectedHistory {fuel : ℕ}
    {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor : Agent) (moment : program.Moment)
    (action : EconomyAction Agent Means Operation) (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history)
    (haction : action ∈ moment.currentStage.menu actor) :
    program.selectByBehavior behavior actor moment action history =
      behavior.selectedHistory actor moment action history := by
  simp [selectByBehavior, hmem, haction]

theorem selectByBehavior_memHist {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor : Agent) (moment : program.Moment)
    (action : EconomyAction Agent Means Operation) (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history)
    (haction : action ∈ moment.currentStage.menu actor) :
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram moment
      (program.selectByBehavior behavior actor moment action history) := by
  classical
  simp [selectByBehavior, hmem, haction,
    behavior.selectedHistory_mem actor moment action history hmem]

theorem selectByBehavior_enacted {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor : Agent) (moment : program.Moment)
    (action : EconomyAction Agent Means Operation) (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history)
    (haction : action ∈ moment.currentStage.menu actor) :
    FiniteEconomyProgram.ProgramHistory.enactedAt
      (program.selectByBehavior behavior actor moment action history) moment actor = action := by
  classical
  simp [selectByBehavior, hmem, haction,
    behavior.selectedHistory_action actor moment action history hmem haction]

theorem selectByBehavior_past {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor : Agent) (moment : program.Moment)
    (action : EconomyAction Agent Means Operation) (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history)
    (haction : action ∈ moment.currentStage.menu actor)
    (past : program.Moment)
    (hbefore : FiniteEconomyProgram.ProgramMoment.Precedence
      program.toFiniteEconomyProgram past moment) (other : Agent) :
    FiniteEconomyProgram.ProgramHistory.enactedAt
        (program.selectByBehavior behavior actor moment action history) past other =
      FiniteEconomyProgram.ProgramHistory.enactedAt history past other := by
  classical
  simpa [selectByBehavior, hmem, haction] using
    (behavior.selectedHistory_past actor moment action history hmem haction
      past hbefore other)

theorem selectByBehavior_other {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor other : Agent)
    (moment : program.Moment) (action : EconomyAction Agent Means Operation)
    (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history)
    (haction : action ∈ moment.currentStage.menu actor) (hne : actor ≠ other) :
    FiniteEconomyProgram.ProgramHistory.enactedAt
      (program.selectByBehavior behavior actor moment action history) moment other =
      FiniteEconomyProgram.ProgramHistory.enactedAt history moment other := by
  classical
  simp [selectByBehavior, hmem, haction,
    behavior.selectedHistory_other actor other moment action history hne hmem haction]

theorem selectByBehavior_centered {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor : Agent) (moment : program.Moment)
    (action : EconomyAction Agent Means Operation) (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history)
    (henacted : FiniteEconomyProgram.ProgramHistory.enactedAt history moment actor = action) :
    program.selectByBehavior behavior actor moment action history = history := by
  classical
  have haction := FiniteEconomyProgram.ProgramHistory.enactedAt_mem_menu
    moment history hmem actor
  have hrequested : action ∈ moment.currentStage.menu actor := by
    simpa [henacted] using haction
  simp [selectByBehavior, hmem, hrequested,
    behavior.selectedHistory_centered actor moment action history hmem hrequested henacted]

/-- The immediate successor on a history, or the current moment when the
history is already terminal. -/
noncomputable def immediateSuccessorHorizon {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (moment : program.Moment) (history : program.History) : program.Moment :=
  moment.maturationAt history

/-- Terminal settlement point on a supplied history. -/
def terminalSettlementHorizon {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (history : program.History) : program.Moment :=
  history.terminalMoment

/-- Select either the immediate successor or the terminal settlement point
on the supplied history. -/
noncomputable def horizonMoment {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (horizon : EvaluationHorizon) (moment : program.Moment)
    (history : program.History) : program.Moment :=
  match horizon with
  | .immediateSuccessor => program.immediateSuccessorHorizon moment history
  | .terminalSettlement => program.terminalSettlementHorizon history

theorem horizonMoment_memHist_future {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (horizon : EvaluationHorizon) (moment : program.Moment)
    (history : program.History)
    (hmem : FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram moment history) :
    FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram
        (program.horizonMoment horizon moment history) history ∧
      (moment = program.horizonMoment horizon moment history ∨
        FiniteEconomyProgram.ProgramMoment.Precedence program.toFiniteEconomyProgram moment
          (program.horizonMoment horizon moment history)) := by
  cases horizon with
  | immediateSuccessor =>
      simpa [horizonMoment, immediateSuccessorHorizon] using
        (FiniteEconomyProgram.ProgramMoment.maturationAt_memHist_future
          moment history hmem)
  | terminalSettlement =>
      exact ⟨history.terminalMoment_memHist,
        FiniteEconomyProgram.ProgramMoment.memHist_precedes_terminal
          moment history hmem⟩

/-- Expected maturation follows the action's declared horizon on its selected
history. -/
noncomputable def expectedMaturation {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor : Agent)
    (moment : program.Moment) (action : EconomyAction Agent Means Operation)
    (history : program.History) : program.Moment :=
  program.horizonMoment (behavior.evaluationHorizon actor moment action) moment history

/-- Physical outcome at a maturation moment is the agent's interpreter-derived
inventory bundle there. -/
def outcomeAt {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (actor : Agent) (moment : program.Moment) : program.End :=
  .bundle ((program.stateAt moment).stock actor)

/-- Intended ends use the program's selection and maturation rules on the
explicit reference history supplied by the behavioral specification. -/
noncomputable def intendedEnd {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor : Agent) (moment : program.Moment)
    (action : EconomyAction Agent Means Operation) : program.End :=
  let selectedHistory := program.selectByBehavior behavior actor moment action
    (behavior.referenceHistory actor moment)
  let evaluationMoment :=
    program.expectedMaturation behavior actor moment action selectedHistory
  .timed (program.outcomeAt actor evaluationMoment) evaluationMoment

/-- Intended ends evaluate the behavioral branch supplied from the reference
history at the same declared horizon used by `ExpectedMaturation`. -/
theorem intendedEnd_uses_behavior_selected_history {fuel : ℕ}
    {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (behavior : program.ActionFrameBehavior) (actor : Agent) (moment : program.Moment)
    (action : EconomyAction Agent Means Operation)
    (haction : action ∈ moment.currentStage.menu actor) :
    program.intendedEnd behavior actor moment action =
      .timed (program.outcomeAt actor
        (program.expectedMaturation behavior actor moment action
          (behavior.selectedHistory actor moment action
            (behavior.referenceHistory actor moment))))
        (program.expectedMaturation behavior actor moment action
          (behavior.selectedHistory actor moment action
            (behavior.referenceHistory actor moment))) := by
  unfold intendedEnd
  rw [program.selectByBehavior_eq_selectedHistory behavior actor moment action
    (behavior.referenceHistory actor moment)
    (behavior.referenceHistory_mem actor moment) haction]

/-- The finite physical program satisfies recursive stock accounting under
the supplied stable operation schedule. -/
theorem physicalAccounting {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (operations : OperationSemantics Operation Means Service)
    (hstable : program.HasStableOperationSemantics operations) :
    FiniteEconomyProgram.PhysicalAccounting
      (fun current actor m => current.stock actor m) operations
      program.toFiniteEconomyProgram :=
  program.physicalAccounting_of_stableOperations operations hstable

/-- The exact stock equation at every immediate program successor. -/
theorem transitionBalance {fuel : ℕ} {state : PhysicalState Agent Means Service}
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (operations : OperationSemantics Operation Means Service)
    (hstable : program.HasStableOperationSemantics operations)
    (moment next : program.Moment) (history : program.History)
    (hnext : IsNextMoment
      (FiniteEconomyProgram.ProgramMoment.Precedence program.toFiniteEconomyProgram)
      (FiniteEconomyProgram.ProgramMoment.memHist program.toFiniteEconomyProgram)
      moment next history) (actor : Agent) (m : Means) :
    (program.stateAt next).stock actor m +
        effectiveUse operations
          (fun i => FiniteEconomyProgram.ProgramHistory.enactedAt history moment i) actor m =
      (program.stateAt moment).stock actor m +
        effectiveYield operations
          (fun i => FiniteEconomyProgram.ProgramHistory.enactedAt history moment i) actor m := by
  have hsuccessor := FiniteEconomyProgram.ProgramMoment.nextOnHistory_eq_of_isNext
    moment history hnext.1 next hnext
  have hbalance := FiniteEconomyProgram.PhysicalAccounting.nextOnHistory_stock_balance
    (fun current actor m => current.stock actor m) operations
    (program.physicalAccounting operations hstable) moment history hnext.1 actor m
  rw [hsuccessor] at hbalance
  exact hbalance

/-- Compile the recursive physical program into the existing `ActionFrame`
interface. Stage menus, successor states, histories, and inventories come from
the finite program and its interpreter. Beliefs, end valuations, and ordinal
preferences remain explicit inputs to `ActionFrameBehavior`. The resulting
frame uses the behavior record's single reference history as its minimal
plausibility set at each moment; this is a certainty assumption of this
constructor, not an implication of physical feasibility. -/
@[reducible] noncomputable def toActionFrame {fuel : ℕ}
    {state : PhysicalState Agent Means Service}
    [Nonempty Agent]
    (program : FinitePhysicalEconomyProgram Agent Means Operation Service fuel state)
    (operations : OperationSemantics Operation Means Service)
    (hstable : program.HasStableOperationSemantics operations)
    (behavior : program.ActionFrameBehavior) : ActionFrame := by
  classical
  exact {
    Agent := Agent
    instNonemptyAgent := inferInstance
    instFintypeAgent := inferInstance
    instDecidableEqAgent := inferInstance
    Moment := program.Moment
    instDecidableEqMoment := inferInstance
    History := program.History
    instDecidableEqHistory := inferInstance
    Action := EconomyAction Agent Means Operation
    instNonemptyAction := ⟨.idle⟩
    instDecidableEqAction := inferInstance
    Means := Means
    instDecidableEqMeans := inferInstance
    Ends := program.End
    instDecidableEqEnds := inferInstance
    alpha_zero := .idle
    Precedence := FiniteEconomyProgram.ProgramMoment.Precedence
      program.toFiniteEconomyProgram
    moment_lt_irrefl := by
      intro t ht
      exact FiniteEconomyProgram.ProgramMoment.precedence_irrefl t ht
    moment_lt_trans := by
      intro t₁ t₂ t₃ h₁₂ h₂₃
      exact FiniteEconomyProgram.ProgramMoment.precedence_trans t₁ t₂ t₃ h₁₂ h₂₃
    backward_linearity := by
      intro t₁ t₂ t₃ h₁₃ h₂₃
      exact FiniteEconomyProgram.ProgramMoment.backward_linearity t₁ t₂ t₃ h₁₃ h₂₃
    mem_hist := FiniteEconomyProgram.ProgramMoment.memHist
      program.toFiniteEconomyProgram
    moment_in_history := by
      intro t
      exact FiniteEconomyProgram.ProgramMoment.exists_history t
    histories_maximal_linear := by
      intro history
      exact FiniteEconomyProgram.ProgramHistory.moments_maximal_linear history
    histories_extensional := by
      intro h₁ h₂ hext
      exact FiniteEconomyProgram.ProgramHistory.extensional h₁ h₂ hext
    divergent_futures_witness := by
      intro t h₁ h₂ ht₁ ht₂ hne
      exact FiniteEconomyProgram.ProgramHistory.divergent_futures
        h₁ h₂ t ht₁ ht₂ hne
    A_cont := fun i t _ => t.currentStage.menu i
    A_cont_bundle_invariant := by
      intro i t h₁ h₂ _ _
      rfl
    alpha_zero_cont := by
      intro i t h
      exact t.currentStage.idle_mem i
    omega := fun i t _ m => (program.stateAt t).stock i m
    omega_bundle_invariant := by
      intro i t m h₁ h₂ _ _
      rfl
    use_means := rawActionUse operations
    yield_means := rawActionYield operations
    use_means_alpha_zero := by
      intro m
      rfl
    yield_means_alpha_zero := by
      intro m
      rfl
    A_feas := fun i t _ => feasibleMenu operations (program.stateAt t) i
      (t.currentStage.menu i)
    A_feas_coupling := by
      intro i t h action
      simpa [actionAffordable] using
        (mem_feasibleMenu_iff operations (program.stateAt t) i
          (t.currentStage.menu i) action)
    enacted := fun i t h =>
      FiniteEconomyProgram.ProgramHistory.enactedAt h t i
    enacted_in_A_feas := by
      intro i t h hmem
      apply (mem_feasibleMenu_iff operations (program.stateAt t) i
        (t.currentStage.menu i)
        (FiniteEconomyProgram.ProgramHistory.enactedAt h t i)).2
      refine ⟨FiniteEconomyProgram.ProgramHistory.enactedAt_mem_menu
        t h hmem i, ?_⟩
      intro m
      exact (FiniteEconomyProgram.PhysicalAccounting.menu_affordable_at
        (fun current actor m => current.stock actor m) operations
        (program.physicalAccounting operations hstable) t i
        (FiniteEconomyProgram.ProgramHistory.enactedAt h t i)
        (FiniteEconomyProgram.ProgramHistory.enactedAt_mem_menu t h hmem i) m)
    no_choice_between_undivided := by
      intro i t u h₁ h₂ ht₁ ht₂ htu hu₁ hu₂
      exact FiniteEconomyProgram.ProgramHistory.enactedAt_eq_of_shared_future
        h₁ h₂ t u htu hu₁ hu₂ i
    sigma := fun i t action history =>
      program.selectByBehavior behavior i t action history
    sigma_realization := by
      intro i t h h' action ht ha ht'
      have hmenu : action ∈ t.currentStage.menu i :=
        (mem_feasibleMenu_iff operations (program.stateAt t) i
          (t.currentStage.menu i) action).1 ha |>.1
      exact ⟨program.selectByBehavior_memHist behavior i t action h' ht' hmenu,
        program.selectByBehavior_enacted behavior i t action h' ht' hmenu⟩
    sigma_centering := by
      intro i t h action ht henacted
      have hmenu : action ∈ t.currentStage.menu i := by
        simpa [henacted] using
          (FiniteEconomyProgram.ProgramHistory.enactedAt_mem_menu t h ht i)
      exact program.selectByBehavior_centered behavior i t action h ht henacted
    sigma_co_agency := by
      intro i j t h h' action hne ht ha ht'
      have hmenu : action ∈ t.currentStage.menu i :=
        (mem_feasibleMenu_iff operations (program.stateAt t) i
          (t.currentStage.menu i) action).1 ha |>.1
      exact program.selectByBehavior_other behavior i j t action h' ht' hmenu hne
    Offer := EconomyAction.offer
    Accept := EconomyAction.accept
    use_means_offer := by
      intro i j qA mA qB mB m
      simp [rawActionUse]
    yield_means_offer := by
      intro i j qA mA qB mB m
      simp [rawActionYield]
    use_means_accept := by
      intro j i qA mA qB mB m
      simp [rawActionUse]
    yield_means_accept := by
      intro j i qA mA qB mB m
      simp [rawActionYield]
    offer_inj := by
      intro i₁ j₁ qA₁ mA₁ qB₁ mB₁ i₂ j₂ qA₂ mA₂ qB₂ mB₂ h
      exact EconomyAction.offer.inj h
    accept_inj := by
      intro j₁ i₁ qA₁ mA₁ qB₁ mB₁ j₂ i₂ qA₂ mA₂ qB₂ mB₂ h
      exact EconomyAction.accept.inj h
    offer_ne_accept := by
      intro i j qA mA qB mB j' i' qA' mA' qB' mB' h
      cases h
    alpha_zero_ne_offer := by
      intro i j qA mA qB mB h
      cases h
    alpha_zero_ne_accept := by
      intro j i qA mA qB mB h
      cases h
    IsTradeAction := fun action => match action with
      | .offer .. => True
      | .accept .. => True
      | _ => False
    is_trade_action_def := by
      intro action
      cases action <;> simp
    law_in_re_transition := by
      intro i t t' h action m hnot haction hnext
      have hbalance := program.transitionBalance operations hstable t t' h hnext i m
      cases action with
      | idle =>
          simpa [rawActionUse, rawActionYield, effectiveUse, effectiveYield,
            haction] using hbalance
      | operate operation =>
          simpa [rawActionUse, rawActionYield, effectiveUse, effectiveYield,
            haction] using hbalance
      | offer seller buyer soldQuantity soldGood paidQuantity paidGood =>
          exact (hnot (by simp)).elim
      | accept buyer seller soldQuantity soldGood paidQuantity paidGood =>
          exact (hnot (by simp)).elim
    unilateral_offer_noop := by
      intro i j qA mA qB mB t t' h m hoff hnot hnext
      have hbalance := program.transitionBalance operations hstable t t' h hnext i m
      simpa [effectiveUse, effectiveYield, hoff, hnot] using hbalance
    unilateral_accept_noop := by
      intro j i qA mA qB mB t t' h m haccept hnot hnext
      have hbalance := program.transitionBalance operations hstable t t' h hnext j m
      simpa [effectiveUse, effectiveYield, haccept, hnot] using hbalance
    bilateral_transfer_law := by
      intro i j qA mA qB mB t t' h m hne hoff haccept hnext
      have hbi := program.transitionBalance operations hstable t t' h hnext i m
      have hbj := program.transitionBalance operations hstable t t' h hnext j m
      have hbi' := hbi
      have hbj' := hbj
      simp only [effectiveUse, effectiveYield, hoff, haccept] at hbi' hbj'
      exact ⟨by simpa [hne] using hbi', by simpa [hne] using hbj'⟩
    MinPlausible := fun i t => {behavior.referenceHistory i t}
    min_plausible_nonempty := by
      intro i t
      exact ⟨behavior.referenceHistory i t, by simp⟩
    tau := fun _ t _ => t
    min_plausible_node_incidence := by
      intro i t history hhistory
      have heq : history = behavior.referenceHistory i t := by
        simpa using hhistory
      subst history
      exact behavior.referenceHistory_mem i t
    tau_centering := by
      intro i t h hmem
      rfl
    requirement := finiteProgramEndRequirement
    ValuedEnd := behavior.valuedEnd
    valued_end_bundle_invariant := behavior.valuedEnd_invariant
    OutcomeOf := fun i _ _ t' _ =>
      .timed (program.outcomeAt i t') t'
    ExpectedMaturation := fun i action t history =>
      program.expectedMaturation behavior i t action history
    expected_maturation_mem_future := by
      intro i action t history hmem _henacted
      exact program.horizonMoment_memHist_future
        (behavior.evaluationHorizon i t action) t history hmem
    End_of := fun i action t _ => program.intendedEnd behavior i t action
    End_of_bundle_invariant := by
      intro i action t h₁ h₂ _ _
      rfl
    Preference := behavior.preference
    Preference_bundle_invariant := behavior.preference_invariant
    pref_asymm := behavior.preference_asymmetric
    doxastic_sure_thing_bridge := by
      intro i action alternative t h _ _ hbetter
      rcases hbetter with ⟨history, hhistory, hpref⟩
      have heq : history = behavior.referenceHistory i t := by
        simpa using hhistory
      subst history
      simpa [intendedEnd, expectedMaturation, outcomeAt, stateAt] using hpref
    doxastic_plausible_support := by
      intro i action alternative t h _ hpref
      refine ⟨behavior.referenceHistory i t, by simp, ?_⟩
      simpa [intendedEnd, expectedMaturation, outcomeAt, stateAt] using hpref
    BundleEnd := FiniteProgramEnd.bundle
    teleological_bundle_dominance_induces_preference :=
      behavior.teleological_dominance_prefers
    TimedEnd := FiniteProgramEnd.timed
    QuantityEnd := FiniteProgramEnd.quantity
    timed_end_inj := by
      intro e₁ t₁ e₂ t₂ h
      exact FiniteProgramEnd.timed.inj h
    quantity_end_inj := by
      intro m₁ q₁ m₂ q₂ h
      exact FiniteProgramEnd.quantity.inj h
  }

end FinitePhysicalEconomyProgram

end Praxeology

